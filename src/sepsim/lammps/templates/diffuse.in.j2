{#- Chain diffusion hold (D53): a long NPT hold at one sweep temperature t_c (deg C) from
    the sweep's hold_<T>C.data (velocities kept), same force field, SHAKE, timestep,
    thermostat/barostat and thermo as the sweep, frames every hold_dump_ps into one
    hold.dcd across all chunks; chunks of chunk_ps, each ending in write_data
    hold_<cumulative ns>ns.data. `sepsim progress` reports D_COM from hold.dcd. -#}
{% import "_ff.in.j2" as ff with context %}
{{ ff.header() -}}
{{ ff.setup() -}}
{{ ff.thermo() -}}
{{ ff.shake() -}}
{% set tdamp = p.tdamp_dt * p.dt_fs %}
{% set pdamp = p.pdamp_dt * p.dt_fs %}
{% set t_k = p.t_c + 273.15 %}
# velocities come from the data file (no velocity create)
thermo {{ n(p.thermo_ps) }}
restart {{ n(p.restart_ps) }} restart.a restart.b

# ---- Stage 1: NPT hold {{ p.diffuse_ps | num }} ps at {{ t_k | num }} K (diffuse, D53; {{ p.t_c | num }} C, {{ p.p_atm | num }} atm) -> hold.dcd, hold_<ns>ns.data
# {{ chunks | length }} chunk(s) of up to {{ p.chunk_ps | num }} ps, each followed by a snapshot; fix md and the dump carry on across the runs
fix md all npt temp {{ t_k | num }} {{ t_k | num }} {{ tdamp | num }} {{ barostat }}
dump hold all dcd {{ n(p.hold_dump_ps) }} hold.dcd
dump_modify hold unwrap yes
{% for c in chunks %}
run {{ n(c.ps) }}
{{ ff.write_data(c.stage) -}}
{% endfor %}
undump hold
unfix md
