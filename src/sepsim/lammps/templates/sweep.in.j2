{#- Temperature sweep (D9, D11, D12c, D12f, D28, D36, D39): NPT iso at p_atm through the
    grid in sweep_grid_c, starting from the prep output (velocities kept). Each grid point
    is a constant-T segment after an instantaneous target change; a DCD per segment, a
    write_data at each hold end and (AA) a short NVE velocity dump for the VDOS. -#}
{% import "_ff.in.j2" as ff with context %}
{{ ff.header() -}}
# Sweep grid ({{ p.sweep_grid_c }}; h = hold): {{ segments | selectattr("kind", "eq", "step") | list | length }} steps + {{ segments | selectattr("kind", "eq", "hold") | list | length }} holds at {{ p.p_atm | num }} atm
#   seg  kind   T/C     T/K       ps        frame/ps  outputs
{% for s in segments %}
#   {{ "%-4s" | format(s.index) }} {{ "%-6s" | format(s.kind) }} {{ "%-7s" | format(s.t_c | num) }} {{ "%-9s" | format(s.t_k | num) }} {{ "%-9s" | format(s.ps | num) }} {{ "%-9s" | format(s.dump_ps | num) }} {{ s.dcd }}{% if s.stage %} {{ s.stage }}.data{% endif %}{% if s.vdos %} {{ s.vdos }}{% endif %}

{% endfor %}
{{ ff.setup() -}}
{{ ff.thermo() -}}
{% set tdamp = p.tdamp_dt * p.dt_fs %}
{% set pdamp = p.pdamp_dt * p.dt_fs %}
{{ ff.shake() -}}
# velocities come from the data file (no velocity create)
thermo {{ n(p.thermo_ps) }}
restart {{ n(p.restart_ps) }} restart.a restart.b
{% for s in segments %}

# ---- Segment {{ s.index }}: {{ s.kind }} at {{ s.t_c | num }} C ({{ s.t_k | num }} K), {{ s.ps | num }} ps, frames every {{ s.dump_ps | num }} ps -> {{ s.dcd }}
{% if s.new_fix %}
fix md all npt temp {{ s.t_k | num }} {{ s.t_k | num }} {{ tdamp | num }} iso {{ p.p_atm | num }} {{ p.p_atm | num }} {{ pdamp | num }}
{% else %}
# same target as the previous segment: fix md continues
{% endif %}
dump traj all dcd {{ n(s.dump_ps) }} {{ s.dcd }}
dump_modify traj unwrap yes
run {{ n(s.ps) }}
undump traj
{% if s.unfix %}
unfix md
{% endif %}
{% if s.stage %}
{{ ff.write(s.stage) -}}
{% endif %}
{% if s.vdos %}
# VDOS (D12c, D39): NVE {{ p.vdos_ps | num }} ps at dt {{ p.vdos_dt_fs | num }} fs, velocities every {{ p.vdos_dump_fs | num }} fs -> {{ s.vdos }}
timestep {{ p.vdos_dt_fs | num }}
thermo {{ n_vdos(p.thermo_ps) }}
fix vdos all nve
dump vel all custom {{ n_vdos(p.vdos_dump_fs / 1000) }} {{ s.vdos }} id type vx vy vz
dump_modify vel sort id
run {{ n_vdos(p.vdos_ps) }}
undump vel
unfix vdos
timestep {{ p.dt_fs | num }}
thermo {{ n(p.thermo_ps) }}
{% endif %}
{% endfor %}
