{#- Temperature sweep (D9, D11, D12c, D12f, D28, D36, D39): NPT iso at p_atm through the
    grid in sweep_grid_c, starting from the prep output (velocities kept). Each grid point
    is a constant-T segment after an instantaneous target change; a DCD per segment, a
    write_data at each hold end and (AA) a short NVE velocity dump for the VDOS. -#}
{% import "_ff.in.j2" as ff with context %}
{% import "_sweep.in.j2" as sw with context %}
{{ ff.header() -}}
{{ sw.grid_table() -}}
{{ ff.setup() -}}
{{ ff.thermo() -}}
{{ ff.shake() -}}
# velocities come from the data file (no velocity create)
thermo {{ n(p.thermo_ps) }}
restart {{ n(p.restart_ps) }} restart.a restart.b
{{ sw.run_segments() -}}
