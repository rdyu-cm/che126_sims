# sepsim 0.1.0 deck: hole
# system pe_cg_hole_r3nm_130C_n320_c240_s1_rep222 (cg), seed 1
# manifest.yaml sha256 dacdddc1703029c96b3344f7c923eb04cfaf346d8dd8d58e34e7c963cbe10750
# data ../../../../systems/pe_cg_hole_r3nm_130C_n320_c240_s1_rep222/data.lmp sha256 a55840a2da19b77896d572e9824c56f7f2711056737cd0827ab0d8675577029f
# forcefield sdk_cg.yaml sha256 9dfe149f91ae1128a039d35e984256101e7e4c4660811a41cff0b252bdb797ba
# Units: ps, fs (dt), K, atm, angstrom. Accelerators come from the command line (-sf/-pk).
# Resolved parameters:
#   chunk_ps = 25000.0
#   dense_dump_ps = 5.0
#   dense_ps = 2000.0
#   dt_fs = 10.0
#   hole_dump_ps = 50.0
#   hole_grid_c = 
#   hole_hold_ps = 20000.0
#   hole_step_ps = 2000.0
#   inflate_ps = 10000.0
#   kspace_accuracy = 0.0
#   lj_cutoff = 15.0
#   neighbor_skin = 2.0
#   p_atm = 1.0
#   pdamp_dt = 1000
#   push_every = 1
#   push_k = 0.5
#   push_style = indent
#   release_t_c = 130
#   restart_ps = 1000.0
#   rho_r = True
#   rho_r_bin = 2.0
#   scaffold = annulus
#   scaffold_col_r_nm = 1.0
#   scaffold_d_nm = 2.5
#   scaffold_hold_ps = 10000.0
#   scaffold_k = 5.0
#   scaffold_n_col = 6
#   shake_iter = 20
#   shake_tol = 0.0001
#   tail = False
#   tdamp_dt = 100
#   thermo_ps = 1.0
#   wall_hold_ps = 10000.0
# Hole (D52): R 3 nm (30 A), axis x 79.0503 y 79.0503 A, built at 130 C; film 132.55 A (154.08 A with the hole), Lz 354.0766 A (fixed), ligament 71.9 A
# Scaffold: annulus, fix spring/self K 5 kcal/mol/A^2 on the beads with r > 55 A at the end of Stage 2 (static group)
# Production grid (cumulative production ns at each segment end):
#    1 hold 130    C 20000     ps -> 20 ns, scaffold released here
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style spica
# nocoeff: every coefficient is set below from the force-field YAML
read_data ../../../../systems/pe_cg_hole_r3nm_130C_n320_c240_s1_rep222/data.lmp nocoeff
special_bonds lj 0 0 1 angle yes

mass 1 42.0804  # CM
mass 2 43.0883  # CT
pair_style lj/spica 15
pair_modify tail no
pair_coeff 1 1 lj9_6 0.42 4.506  # CM-CM
pair_coeff 1 2 lj9_6 0.444 4.5455  # CM-CT
pair_coeff 2 2 lj9_6 0.469 4.585  # CT-CT
bond_coeff 1 6.16 3.64  # CM-CM
bond_coeff 2 6.16 3.65  # CM-CT
angle_coeff 1 1.19 173  # CM-CM-CM
angle_coeff 2 1.19 175  # CM-CM-CT

neighbor 2 bin
neigh_modify delay 0 every 1 check yes
timestep 10
thermo_style custom step time temp press pe ke etotal enthalpy vol density lx ly lz pxx pyy pzz evdwl ecoul elong ebond eangle edihed cpu
thermo_modify flush yes

# rolling restart files (alternating restart.a / restart.b)
restart 100000 restart.a restart.b
thermo 100
# velocities come from the data file (no velocity create)
fix md all nvt temp 403.15 403.15 1000

# ---- Stage 1: inflate 10000 ps NVT at 403.15 K, radial push r0 0 -> 30 A (indent, K 0.5) -> inflate.dcd
variable r0 equal ramp(0.0,30)
# cylindrical indenter about the axis: F = K (r0 - r)^2 outward on beads with r < r0 (minimum image)
fix push all indent 0.5 cylinder z 79.0503366702 79.0503366702 v_r0 side out units box
dump inflate all dcd 5000 inflate.dcd
dump_modify inflate unwrap yes
run 1000000

# ---- Stage 2: hold at R 10000 ps NVT at 403.15 K, push at r0 = 30 A -> inflate.dcd, inflated.data
variable r0 equal 30
run 1000000
undump inflate
write_data inflated.data pair ij
write_restart inflated.restart
unfix push

# scaffold group from the positions in inflated.data (static), tethered in place; the beads stay in fix md
region scaffold cylinder z 79.0503366702 79.0503366702 55 INF INF side out units box
group scaffold region scaffold
fix scaffold scaffold spring/self 5
fix_modify scaffold energy yes

# ---- Stage 3: scaffolded hold 10000 ps NVT at 403.15 K, push off, scaffold on -> hole_scaf.dcd, hole_scaf.data
dump hole_scaf all dcd 5000 hole_scaf.dcd
dump_modify hole_scaf unwrap yes
run 1000000
undump hole_scaf
write_data hole_scaf.data pair ij

# ---- Stage 4: hold at 130 C (hole segment 1/1, 20000 ps NVT, scaffold released here) -> hole.dcd, hole_dense_s01.dcd, hole_20ns.data
unfix scaffold
dump hole all dcd 5000 hole.dcd
dump_modify hole unwrap yes
# live diagnostic: radial bead mass density about the hole axis (whole film thickness)
compute rbin all chunk/atom bin/cylinder z lower 354.076581646 79.0503366702 79.0503366702 0.0 64 32 units box
fix rho_r all ave/chunk 100 50 5000 rbin density/mass file hole_rho_r.txt
# dense frames: the first 2000 ps of this segment every 5 ps
dump dense all dcd 500 hole_dense_s01.dcd
dump_modify dense unwrap yes
run 200000
undump dense
run 1800000
write_data hole_20ns.data pair ij
undump hole
unfix rho_r
