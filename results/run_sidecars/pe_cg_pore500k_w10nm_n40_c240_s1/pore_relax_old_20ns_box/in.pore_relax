# sepsim 0.1.0 deck: pore_relax
# system pe_cg_pore500k_w10nm_n40_c240_s1 (cg), seed 1
# manifest.yaml sha256 dadfd17a6c1fcb58f606b0fbee96bf0dc40494e7ab87858fb2256951c3e3ffb2
# data ../../../../systems/pe_cg_pore500k_w10nm_n40_c240_s1/data.lmp sha256 c301f0027d280ab622539fc5957572c62ddd1eb1cb097457577f53ddbafdc52c
# forcefield sdk_cg.yaml sha256 9dfe149f91ae1128a039d35e984256101e7e4c4660811a41cff0b252bdb797ba
# Units: ps, fs (dt), K, atm, angstrom. Accelerators come from the command line (-sf/-pk).
# Resolved parameters:
#   dt_fs = 10.0
#   hold_dump_ps = 10.0
#   kspace_accuracy = 0.0
#   lj_cutoff = 15.0
#   min_etol = 0.0001
#   min_ftol = 1e-06
#   min_maxeval = 100000
#   min_maxiter = 10000
#   neighbor_skin = 2.0
#   p_atm = 1.0
#   pdamp_dt = 1000
#   relax_ps = 5000.0
#   restart_ps = 1000.0
#   shake_iter = 20
#   shake_tol = 0.0001
#   t_melt = 500.0
#   tail = False
#   tdamp_dt = 100
#   thermo_ps = 1.0
# Pore (D48 wide): width 10 nm at 500 K (mass-equivalent), wall 67.8132764603 A (replicate_z 1), box fixed: Lz 167.81327646 A
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style spica
# nocoeff: every coefficient is set below from the force-field YAML
read_data ../../../../systems/pe_cg_pore500k_w10nm_n40_c240_s1/data.lmp nocoeff
special_bonds lj 0 0 1 angle yes

mass 1 42.0804  # CM
mass 2 43.0883  # CT
pair_style lj/spica 15
pair_modify tail no
pair_coeff 1 1 lj9_6 0.42 4.506  # CM-CM
pair_coeff 1 2 lj9_6 0.444 4.5455  # CM-CT
pair_coeff 2 2 lj9_6 0.469 4.585  # CT-CT
bond_coeff 1 6.16 3.64  # CM-CM
bond_coeff 2 6.16 3.65  # CM-CT
angle_coeff 1 1.19 173  # CM-CM-CM
angle_coeff 2 1.19 175  # CM-CM-CT

neighbor 2 bin
neigh_modify delay 0 every 1 check yes
timestep 10
thermo_style custom step time temp press pe ke etotal enthalpy vol density lx ly lz pxx pyy pzz evdwl ecoul elong ebond eangle edihed cpu
thermo_modify flush yes

# rolling restart files from here on (alternating restart.a / restart.b)
restart 100000 restart.a restart.b

# ---- Stage 1: minimize the opened slab
thermo 100
minimize 0.0001 1e-06 10000 100000
write_data minimized.data pair ij
write_restart minimized.restart
# the minimizer advanced the step counter: restart it so dump intervals line up
reset_timestep 0

# ---- Stage 2: surface relaxation 5000 ps NVT at 500 K, box fixed -> relaxed.data, relax.dcd
# velocities come from the data file (no velocity create)
thermo 100
fix md all nvt temp 500 500 1000
dump relax all dcd 1000 relax.dcd
dump_modify relax unwrap yes
run 500000
undump relax
unfix md
write_data relaxed.data pair ij
write_restart relaxed.restart
