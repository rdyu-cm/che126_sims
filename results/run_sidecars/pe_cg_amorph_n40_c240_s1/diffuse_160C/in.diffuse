# sepsim 0.1.0 deck: diffuse
# system pe_cg_amorph_n40_c240_s1 (cg), seed 1
# manifest.yaml sha256 be94805b7ab7d340773f4aac950d8c88ba3106377c963af80451fabc5b7ef4b3
# data ../sweep/hold_160C.data sha256 ab8df4abfa77fcf58bff0840f71fe4701f3c4329cf0c5826009d7515cac67196
# forcefield sdk_cg.yaml sha256 9dfe149f91ae1128a039d35e984256101e7e4c4660811a41cff0b252bdb797ba
# Units: ps, fs (dt), K, atm, angstrom. Accelerators come from the command line (-sf/-pk).
# Resolved parameters:
#   chunk_ps = 25000.0
#   diffuse_ps = 300000.0
#   dt_fs = 10.0
#   hold_dump_ps = 100.0
#   kspace_accuracy = 0.0
#   lj_cutoff = 15.0
#   neighbor_skin = 2.0
#   p_atm = 1.0
#   pdamp_dt = 1000
#   restart_ps = 1000.0
#   shake_iter = 20
#   shake_tol = 0.0001
#   t_c = 160.0
#   tail = False
#   tdamp_dt = 100
#   thermo_ps = 1.0
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style spica
# nocoeff: every coefficient is set below from the force-field YAML
read_data ../sweep/hold_160C.data nocoeff
special_bonds lj 0 0 1 angle yes

mass 1 42.0804  # CM
mass 2 43.0883  # CT
pair_style lj/spica 15
pair_coeff 1 1 lj9_6 0.42 4.506  # CM-CM
pair_coeff 1 2 lj9_6 0.444 4.5455  # CM-CT
pair_coeff 2 2 lj9_6 0.469 4.585  # CT-CT
bond_coeff 1 6.16 3.64  # CM-CM
bond_coeff 2 6.16 3.65  # CM-CT
angle_coeff 1 1.19 173  # CM-CM-CM
angle_coeff 2 1.19 175  # CM-CM-CT

neighbor 2 bin
neigh_modify delay 0 every 1 check yes
timestep 10
thermo_style custom step time temp press pe ke etotal enthalpy vol density lx ly lz evdwl ecoul elong ebond eangle edihed cpu
thermo_modify flush yes
# velocities come from the data file (no velocity create)
thermo 100
restart 100000 restart.a restart.b

# ---- Stage 1: NPT hold 300000 ps at 433.15 K (diffuse, D53; 160 C, 1 atm) -> hold.dcd, hold_<ns>ns.data
# 12 chunk(s) of up to 25000 ps, each followed by a snapshot; fix md and the dump carry on across the runs
fix md all npt temp 433.15 433.15 1000 iso 1 1 10000
dump hold all dcd 10000 hold.dcd
dump_modify hold unwrap yes
run 2500000
write_data hold_25ns.data pair ij
run 2500000
write_data hold_50ns.data pair ij
run 2500000
write_data hold_75ns.data pair ij
run 2500000
write_data hold_100ns.data pair ij
run 2500000
write_data hold_125ns.data pair ij
run 2500000
write_data hold_150ns.data pair ij
run 2500000
write_data hold_175ns.data pair ij
run 2500000
write_data hold_200ns.data pair ij
run 2500000
write_data hold_225ns.data pair ij
run 2500000
write_data hold_250ns.data pair ij
run 2500000
write_data hold_275ns.data pair ij
run 2500000
write_data hold_300ns.data pair ij
undump hold
unfix md
