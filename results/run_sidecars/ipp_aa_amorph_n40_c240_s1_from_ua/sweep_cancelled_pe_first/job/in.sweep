# sepsim 0.1.0 deck: sweep
# system ipp_aa_amorph_n40_c240_s1_from_ua (aa), seed 1
# manifest.yaml sha256 d0f39d8fa962acc2af28363218836c0b4c6177beab8a6dc7019fc414dd6d2a52
# data ../prep/cooled.data sha256 n/a: not present at render time (made by an earlier stage; run_manifest.json hashes it)
# forcefield opls2020_aa.yaml sha256 d689069854bb4591e1020c7b5fb67c6c84b17dee88b85771c9e53545060c3151
# Units: ps, fs (dt), K, atm, angstrom. Accelerators come from the command line (-sf/-pk).
# Resolved parameters:
#   burst_dt_ps = 0.1
#   burst_len_ps = 10.0
#   burst_period_ps = 1000.0
#   dt_fs = 1.0
#   hold_dump_ps = 10.0
#   kspace_accuracy = 1e-05
#   lj_cutoff = 12.0
#   neighbor_skin = 2.0
#   p_atm = 1.0
#   pdamp_dt = 1000
#   restart_ps = 1000.0
#   shake_iter = 20
#   shake_tol = 0.0001
#   step_dump_ps = 100.0
#   step_ps = 1000.0
#   sweep_grid_c = 25h,35,45,55,65,75,85,90h,100,110,120,130h,140,150,160h
#   sweep_hold_ps = 5000.0
#   tail = True
#   tdamp_dt = 100
#   thermo_ps = 1.0
#   vdos = True
#   vdos_dt_fs = 1.0
#   vdos_dump_fs = 4.0
#   vdos_gzip = True
#   vdos_ps = 10.0
# Sweep grid (25h,35,45,55,65,75,85,90h,100,110,120,130h,140,150,160h; h = hold): 14 steps + 4 holds at 1 atm
#   seg  kind   T/C     T/K       ps        frame/ps  outputs
#   1    hold   25      298.15    5000      10        seg01_hold_25C.dcd hold_25C.data vdos_25C.dump.gz seg01_hold_25C_burst01-05.dcd
#   2    step   35      308.15    1000      100       seg02_step_35C.dcd
#   3    step   45      318.15    1000      100       seg03_step_45C.dcd
#   4    step   55      328.15    1000      100       seg04_step_55C.dcd
#   5    step   65      338.15    1000      100       seg05_step_65C.dcd
#   6    step   75      348.15    1000      100       seg06_step_75C.dcd
#   7    step   85      358.15    1000      100       seg07_step_85C.dcd
#   8    step   90      363.15    1000      100       seg08_step_90C.dcd
#   9    hold   90      363.15    5000      10        seg09_hold_90C.dcd hold_90C.data vdos_90C.dump.gz seg09_hold_90C_burst01-05.dcd
#   10   step   100     373.15    1000      100       seg10_step_100C.dcd
#   11   step   110     383.15    1000      100       seg11_step_110C.dcd
#   12   step   120     393.15    1000      100       seg12_step_120C.dcd
#   13   step   130     403.15    1000      100       seg13_step_130C.dcd
#   14   hold   130     403.15    5000      10        seg14_hold_130C.dcd hold_130C.data vdos_130C.dump.gz seg14_hold_130C_burst01-05.dcd
#   15   step   140     413.15    1000      100       seg15_step_140C.dcd
#   16   step   150     423.15    1000      100       seg16_step_150C.dcd
#   17   step   160     433.15    1000      100       seg17_step_160C.dcd
#   18   hold   160     433.15    5000      10        seg18_hold_160C.dcd hold_160C.data vdos_160C.dump.gz seg18_hold_160C_burst01-05.dcd
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
dihedral_style opls
# nocoeff: every coefficient is set below from the force-field YAML
read_data ../prep/cooled.data nocoeff
special_bonds lj 0 0 0.5 coul 0 0 0.5

mass 1 12.011  # CT_CH3
mass 2 12.011  # CT_CH3_iso
mass 3 12.011  # CT_CH2
mass 4 12.011  # CT_CH
mass 5 1.008  # HC
pair_style lj/cut/coul/long 12
pair_modify mix geometric tail yes
pair_coeff 1 1 0.066 3.55  # CT_CH3
pair_coeff 2 2 0.072 3.4  # CT_CH3_iso
pair_coeff 3 3 0.066 3.51  # CT_CH2
pair_coeff 4 4 0.066 3.5  # CT_CH
pair_coeff 5 5 0.026 2.48  # HC
kspace_style pppm 1e-05
bond_coeff 1 268 1.529  # CT-CT
bond_coeff 2 340 1.09  # CT-HC
angle_coeff 1 58.35 112.7  # CT-CT-CT
angle_coeff 2 37.5 110.7  # CT-CT-HC
angle_coeff 3 33 107.8  # HC-CT-HC
dihedral_coeff 1 0.85 -0.2 0.2 0  # CT-CT-CT-CT
dihedral_coeff 2 0 0 0.3 0  # HC-CT-CT-CT
dihedral_coeff 3 0 0 0.3 0  # HC-CT-CT-HC

neighbor 2 bin
neigh_modify delay 0 every 1 check yes
timestep 1
thermo_style custom step time temp press pe ke etotal enthalpy vol density lx ly lz evdwl ecoul elong ebond eangle edihed cpu
thermo_modify flush yes
# velocities come from the data file (no velocity create)
thermo 1000
restart 1000000 restart.a restart.b

# ---- Segment 1: hold at 25 C (298.15 K), 5000 ps, frames every 10 ps -> seg01_hold_25C.dcd
fix md all npt temp 298.15 298.15 100 iso 1 1 1000
dump traj all dcd 10000 seg01_hold_25C.dcd
dump_modify traj unwrap yes
# D46: the hold runs in 5 chunk(s) of 1000 ps; each starts with a dense burst (10 ps, frames every 0.1 ps, own file); fix md and dump traj carry on across the runs
dump burst all dcd 100 seg01_hold_25C_burst01.dcd
dump_modify burst unwrap yes
run 10000
undump burst
run 990000
dump burst all dcd 100 seg01_hold_25C_burst02.dcd
dump_modify burst unwrap yes
run 10000
undump burst
run 990000
dump burst all dcd 100 seg01_hold_25C_burst03.dcd
dump_modify burst unwrap yes
run 10000
undump burst
run 990000
dump burst all dcd 100 seg01_hold_25C_burst04.dcd
dump_modify burst unwrap yes
run 10000
undump burst
run 990000
dump burst all dcd 100 seg01_hold_25C_burst05.dcd
dump_modify burst unwrap yes
run 10000
undump burst
run 990000
undump traj
unfix md
write_data hold_25C.data
write_restart hold_25C.restart
# VDOS (D12c, D39): NVE 10 ps at dt 1 fs, velocities every 4 fs -> vdos_25C.dump.gz
timestep 1
thermo 1000
fix vdos all nve
dump vel all custom 4 vdos_25C.dump.gz id type vx vy vz
dump_modify vel sort id
run 10000
undump vel
unfix vdos
timestep 1
thermo 1000

