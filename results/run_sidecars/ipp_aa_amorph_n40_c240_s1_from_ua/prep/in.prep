# sepsim 0.1.0 deck: prep
# system ipp_aa_amorph_n40_c240_s1_from_ua (aa), seed 1
# manifest.yaml sha256 d0f39d8fa962acc2af28363218836c0b4c6177beab8a6dc7019fc414dd6d2a52
# data ../../../../systems/ipp_aa_amorph_n40_c240_s1_from_ua/data.lmp sha256 4a7d982f69f2a01db084a62ae4aa2389ac356d1ddbcd124aec0f6c02dc7d930c
# forcefield opls2020_aa.yaml sha256 d689069854bb4591e1020c7b5fb67c6c84b17dee88b85771c9e53545060c3151
# Units: ps, fs (dt), K, atm, angstrom. Accelerators come from the command line (-sf/-pk).
# Resolved parameters:
#   compress_hi_ps = 200.0
#   compress_ps = 800.0
#   cool_dump_ps = 100.0
#   cool_step_ps = 1000.0
#   cool_steps = 8
#   dt_fs = 1.0
#   hold_dump_ps = 10.0
#   hold_ps = 5000.0
#   kspace_accuracy = 1e-05
#   lj_cutoff = 12.0
#   min_etol = 0.0001
#   min_ftol = 1e-06
#   min_maxeval = 100000
#   min_maxiter = 10000
#   neighbor_skin = 2.0
#   nvt_ps = 100.0
#   p_atm = 1.0
#   p_compress_atm = 100.0
#   pdamp_dt = 1000
#   pushoff = True
#   pushoff_a_max = 50.0
#   pushoff_dt_fs = 0.5
#   pushoff_nve_limit = 0.1
#   pushoff_ps = 20.0
#   pushoff_rc = 3.0
#   pushoff_t = 500.0
#   restart_ps = 1000.0
#   shake_iter = 20
#   shake_tol = 0.0001
#   t_final = 298.15
#   t_melt = 500.0
#   tail = True
#   tdamp_dt = 100
#   thermo_ps = 1.0
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
dihedral_style opls
# nocoeff: every coefficient is set below from the force-field YAML
read_data ../../../../systems/ipp_aa_amorph_n40_c240_s1_from_ua/data.lmp nocoeff
special_bonds lj 0 0 0.5 coul 0 0 0.5

mass 1 12.011  # CT_CH3
mass 2 12.011  # CT_CH3_iso
mass 3 12.011  # CT_CH2
mass 4 12.011  # CT_CH
mass 5 1.008  # HC
pair_style lj/cut/coul/long 12
pair_modify mix geometric tail yes
pair_coeff 1 1 0.066 3.55  # CT_CH3
pair_coeff 2 2 0.072 3.4  # CT_CH3_iso
pair_coeff 3 3 0.066 3.51  # CT_CH2
pair_coeff 4 4 0.066 3.5  # CT_CH
pair_coeff 5 5 0.026 2.48  # HC
kspace_style pppm 1e-05
bond_coeff 1 268 1.529  # CT-CT
bond_coeff 2 340 1.09  # CT-HC
angle_coeff 1 58.35 112.7  # CT-CT-CT
angle_coeff 2 37.5 110.7  # CT-CT-HC
angle_coeff 3 33 107.8  # HC-CT-HC
dihedral_coeff 1 0.85 -0.2 0.2 0  # CT-CT-CT-CT
dihedral_coeff 2 0 0 0.3 0  # HC-CT-CT-CT
dihedral_coeff 3 0 0 0.3 0  # HC-CT-CT-HC

neighbor 2 bin
neigh_modify delay 0 every 1 check yes
timestep 1
thermo_style custom step time temp press pe ke etotal enthalpy vol density lx ly lz evdwl ecoul elong ebond eangle edihed cpu
thermo_modify flush yes

# ---- Stage 1: soft-core push-off (D31): bonded terms on, no Coulomb, a ramps 0 -> 50
kspace_style none
pair_style soft 3
# keep the full-FF ghost cutoff: soft rc + skin is shorter than LAMMPS's bonded-length estimate
comm_modify cutoff 14
pair_coeff * * 0.0
variable A equal ramp(0,50)
fix pushoff_adapt all adapt 1 pair soft a * * v_A
fix pushoff_nve all nve/limit 0.1
fix pushoff_lang all langevin 500 500 50 1
timestep 0.5
thermo 2000
run 40000
unfix pushoff_lang
unfix pushoff_nve
unfix pushoff_adapt
comm_modify cutoff 0.0
# back to the full force field: a new pair_style erases all pair_coeff/pair_modify settings
pair_style lj/cut/coul/long 12
pair_modify mix geometric tail yes
pair_coeff 1 1 0.066 3.55  # CT_CH3
pair_coeff 2 2 0.072 3.4  # CT_CH3_iso
pair_coeff 3 3 0.066 3.51  # CT_CH2
pair_coeff 4 4 0.066 3.5  # CT_CH
pair_coeff 5 5 0.026 2.48  # HC
kspace_style pppm 1e-05
timestep 1
write_data pushoff.data
write_restart pushoff.restart

# rolling restart files from here on (alternating restart.a / restart.b)
restart 1000000 restart.a restart.b

# ---- Stage 2: minimize with the full force field
thermo 100
minimize 0.0001 1e-06 10000 100000
write_data minimized.data
write_restart minimized.restart

# ---- Stage 4: NVT 100 ps at 500 K -> relaxed.data (input for `sepsim build ua2aa`)
thermo 1000
velocity all create 500 1 mom yes rot yes dist gaussian
fix md all nvt temp 500 500 100
run 100000
unfix md
write_data relaxed.data
write_restart relaxed.restart
# ---- Stage 5: NPT compression at 500 K: 100 atm, then 1 atm -> compressed.data
fix md all npt temp 500 500 100 iso 100 100 1000
run 200000
unfix md
fix md all npt temp 500 500 100 iso 1 1 1000
run 800000
unfix md
write_data compressed.data
write_restart compressed.restart
# ---- Stage 6: NPT hold 5000 ps at 500 K, 1 atm -> hold.data, hold.dcd
fix md all npt temp 500 500 100 iso 1 1 1000
dump hold all dcd 10000 hold.dcd
dump_modify hold unwrap yes
run 5000000
undump hold
unfix md
write_data hold.data
write_restart hold.restart
# ---- Stage 7: step-cool 500 -> 298.15 K in 8 steps of 1000 ps at 1 atm -> cooled.data, cool.dcd
dump cool all dcd 100000 cool.dcd
dump_modify cool unwrap yes
# cool step 1/8: 474.76875 K
fix md all npt temp 474.76875 474.76875 100 iso 1 1 1000
run 1000000
unfix md
# cool step 2/8: 449.5375 K
fix md all npt temp 449.5375 449.5375 100 iso 1 1 1000
run 1000000
unfix md
# cool step 3/8: 424.30625 K
fix md all npt temp 424.30625 424.30625 100 iso 1 1 1000
run 1000000
unfix md
# cool step 4/8: 399.075 K
fix md all npt temp 399.075 399.075 100 iso 1 1 1000
run 1000000
unfix md
# cool step 5/8: 373.84375 K
fix md all npt temp 373.84375 373.84375 100 iso 1 1 1000
run 1000000
unfix md
# cool step 6/8: 348.6125 K
fix md all npt temp 348.6125 348.6125 100 iso 1 1 1000
run 1000000
unfix md
# cool step 7/8: 323.38125 K
fix md all npt temp 323.38125 323.38125 100 iso 1 1 1000
run 1000000
unfix md
# cool step 8/8: 298.15 K
fix md all npt temp 298.15 298.15 100 iso 1 1 1000
run 1000000
unfix md
undump cool
write_data cooled.data
write_restart cooled.restart
