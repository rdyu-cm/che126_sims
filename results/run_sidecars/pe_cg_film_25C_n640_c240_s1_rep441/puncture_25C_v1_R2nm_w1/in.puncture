# sepsim 0.1.0 deck: puncture
# system pe_cg_film_25C_n640_c240_s1_rep441 (cg), seed 1
# manifest.yaml sha256 b1d127f883b66ac114d2e46e5823365718ad038117fae7585a5805b94cdc68d8
# data ../../../../systems/pe_cg_film_25C_n640_c240_s1_rep441/data.lmp sha256 a61ff199694aae630a9225cd17d1d1447edf414515f26e2f8dac378e95457a5c
# forcefield sdk_cg.yaml sha256 9dfe149f91ae1128a039d35e984256101e7e4c4660811a41cff0b252bdb797ba
# Units: ps, fs (dt), K, atm, angstrom. Accelerators come from the command line (-sf/-pk).
# Resolved parameters:
#   avg_ps = 100.0
#   boundary = p p m
#   clamp_k = 5.0
#   clamp_r_nm = 8.0
#   clearance_nm = 1.0
#   dt_fs = 10.0
#   indent_k = 1.0
#   indent_r_nm = 2.0
#   indent_v_m_s = 1.0
#   indent_x_nm = 0.0
#   indent_y_nm = 0.0
#   kspace_accuracy = 0.0
#   lj_cutoff = 15.0
#   neighbor_skin = 2.0
#   overshoot_nm = 2.0
#   p_atm = 1.0
#   pdamp_dt = 1000
#   puncture_dump_ps = 200.0
#   restart_ps = 1000.0
#   settle_ps = 200.0
#   shaft_cut_a = 3.0
#   shaft_eps = 5.0
#   shake_iter = 20
#   shake_tol = 0.0001
#   tag = w1
#   tail = False
#   tdamp_dt = 100
#   thermo_ps = 1.0
#   thermostat = nvt
#   travel_nm = 20.0
# Puncture (D57): film at 25 C, 64.53 A thick, z extent 29.84..109.13 A (build); boundary p p m
# Indenter: R 2 nm (20 A), axis x 146.4652 y 146.4652 A, K 1 kcal/mol/A^3; 1 m/s = 1e-05 A/fs; tip centre z 139.1337 -> -60.8663 A (travel 200.0000 A) in 2000000 steps
units real
atom_style full
boundary p p m
bond_style harmonic
angle_style spica
# nocoeff: every coefficient is set below from the force-field YAML
read_data ../../../../systems/pe_cg_film_25C_n640_c240_s1_rep441/data.lmp nocoeff
special_bonds lj 0 0 1 angle yes

mass 1 42.0804  # CM
mass 2 43.0883  # CT
pair_style lj/spica 15
pair_modify tail no
pair_coeff 1 1 lj9_6 0.42 4.506  # CM-CM
pair_coeff 1 2 lj9_6 0.444 4.5455  # CM-CT
pair_coeff 2 2 lj9_6 0.469 4.585  # CT-CT
bond_coeff 1 6.16 3.64  # CM-CM
bond_coeff 2 6.16 3.65  # CM-CT
angle_coeff 1 1.19 173  # CM-CM-CM
angle_coeff 2 1.19 175  # CM-CM-CT

neighbor 2 bin
neigh_modify delay 0 every 1 check yes
timestep 10
thermo_style custom step time temp press pe ke etotal enthalpy vol density lx ly lz pxx pyy pzz evdwl ecoul elong ebond eangle edihed cpu
thermo_modify flush yes

# rolling restart files (alternating restart.a / restart.b)
restart 100000 restart.a restart.b
thermo 100
# velocities come from the data file (no velocity create)
fix md all nvt temp 298.15 298.15 1000

# indenter: sphere (tip) + cylinder above it (shaft), tip centre at v_zc
# shaft: region radius 17 A = R - cut, from the tip centre (inside the sphere) to
# 539.133708637 A (z0 + travel + 200: the top stays >= 200 A above the start); moves with v_zc
# via v_dz (Stage 1 0, Stage 2 the ramp). fix wall/region harmonic E = eps (cut - r)^2 at
# distance r < cut from the region surface, force along its normal; its vector is the
# total force on the wall from the beads, the force on the indenter as fix indent's, so
# F = f_tip[3] + f_shaft[3] (smoke 2026-11-16)
variable zc equal 139.133708637
variable dz equal v_zc-139.133708637
fix tip all indent 1 sphere 146.46522462 146.46522462 v_zc 20 units box
region shaftr cylinder z 146.46522462 146.46522462 17 139.133708637 539.133708637 side out move NULL NULL v_dz units box
fix shaft all wall/region shaftr harmonic 5 1 3
fix_modify tip energy yes
fix_modify shaft energy yes
# clamp: beads beyond 8 nm of the axis now, tethered in z to their start (x, y free)
region clampr cylinder z 146.46522462 146.46522462 80 INF INF side out units box
group clamped region clampr
fix clamp clamped spring/self 5 z
# diagnostics: T near the axis (r < R + 10 A) and in the far field (r > R + 50 A), bead z range
region near cylinder z 146.46522462 146.46522462 30 INF INF units box
region far cylinder z 146.46522462 146.46522462 70 INF INF side out units box
compute tnear all temp/region near
compute tfar all temp/region far
compute zmin all reduce min z
compute zmax all reduce max z
fix pave all ave/time 1 10000 10000 v_zc f_tip[1] f_tip[2] f_tip[3] f_shaft[1] f_shaft[2] f_shaft[3] f_tip f_shaft c_thermo_temp c_tnear c_tfar c_zmin c_zmax c_thermo_press[3] file puncture.txt

# ---- Stage 1: settle 200 ps NVT at 298.15 K, indenter clear of the film (tip bottom 1 nm above it) -> settle.dcd
dump settle all dcd 20000 settle.dcd
dump_modify settle unwrap yes
run 20000
undump settle

# ---- Stage 2: indent at 1 m/s, R 2 nm, travel 20 nm (NVT at 298.15 K) -> puncture.dcd, punctured.data
variable zc equal ramp(139.133708637,-60.8662913634)
dump puncture all dcd 20000 puncture.dcd
dump_modify puncture unwrap yes
run 2000000
undump puncture
unfix pave
write_data punctured.data pair ij
