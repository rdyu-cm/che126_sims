.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# LAMMPS run artifacts (raw output is not committed); runs/ also covers results/runs/
runs/
logs/
# Slurm decks + job.sh from `sepsim render --job` (synced by ssubmit, never committed)
/jobs/
# Local throughput charts and their CSVs (make_plots.py redraws them), kept off git
/results/benchmarks/
log.lammps
log.*.lammps
*.lammpstrj
*.dcd
restart.*
*.restart

# Build artifacts (top-level only; src/sepsim/build is a package)
dist/
/build/

# Local copies of papers (copyrighted; never committed)
/references/

# LAMMPS builds and Apptainer images live in ../installations (scripts/build_lammps.sh);
# never commit them, even if SEPSIM_INSTALL_DIR points inside the repo
/installations/
*.sif
